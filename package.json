{
  "name": "ops-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/web/server.ts",
    "build": "tsc && cp -R src/db/migrations dist/db/",
    "start": "npm run start:web",
    "start:web": "node dist/db/migrate.js && node dist/web/server.js",
    "start:worker": "node dist/jobs/sync.js",
    "migrate": "tsx src/db/migrate.ts",
    "sync": "tsx src/jobs/sync.ts",
    "brief": "tsx src/jobs/brief.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "dotenv": "^16.4.5",
    "pg": "^8.13.1",
    "resend": "^6.19.0",
    "twilio": "^6.1.0"
  },
  "devDependencies": {
    "@railway/cli": "^5.38.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
