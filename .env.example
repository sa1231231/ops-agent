# Copy to .env and fill in. .env is gitignored — never commit it.

# --- Database ---------------------------------------------------------------
# Locally, use Railway's DATABASE_PUBLIC_URL (routes through the TCP proxy).
# Inside Railway, the platform injects DATABASE_URL on the private network.
DATABASE_URL=postgresql://postgres:PASSWORD@HOST.proxy.rlwy.net:PORT/railway

# --- Token encryption -------------------------------------------------------
# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this key makes every stored OAuth token undecryptable.
TOKEN_ENC_KEY=

# --- Google OAuth (read-only scopes only) -----------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:3000/oauth/callback

# --- Admin console ----------------------------------------------------------
ADMIN_SECRET=
PUBLIC_BASE_URL=http://localhost:3000
PORT=3000

# --- Anthropic --------------------------------------------------------------
ANTHROPIC_API_KEY=

# --- Delivery ---------------------------------------------------------------
# sms | whatsapp | none. `none` renders and stores the brief without sending,
# which exercises the whole pipeline end to end before a number is live.
DELIVERY_CHANNEL=sms

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# SMS (preferred): no templates and no per-layout approval, so the brief's
# format can change whenever the ranking improves. E.164, e.g. +15715551234
TWILIO_SMS_FROM=
CLIENT_SMS_NUMBER=

# WhatsApp (alternative): needs a Meta-approved template, and template
# parameters cannot contain newlines. Every layout change means re-approval.
TWILIO_WHATSAPP_FROM=
WHATSAPP_TEMPLATE_SID=
CLIENT_WHATSAPP_NUMBER=

# --- Operator alerting (never the client's WhatsApp) ------------------------
OPERATOR_EMAIL=
OPERATOR_EMAIL_FROM=
RESEND_API_KEY=

# --- Brief scheduling -------------------------------------------------------
# Cron runs hourly in UTC and gates on BRIEF_HOUR in BRIEF_TZ, so DST is a no-op.
BRIEF_TZ=America/New_York
BRIEF_HOUR=6
